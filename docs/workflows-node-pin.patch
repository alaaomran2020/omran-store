+          fi
 
       - name: Sync Instagram feed
+        if: steps.creds.outputs.ready == 'true'
         env:
           INSTAGRAM_ACCESS_TOKEN: ${{ secrets.INSTAGRAM_ACCESS_TOKEN }}
           INSTAGRAM_USER_ID: ${{ vars.INSTAGRAM_USER_ID }}
@@ -40,12 +54,17 @@ jobs:
         run: node scripts/sync-instagram-feed.mjs
 
       - name: Commit changed feed data
+        if: steps.creds.outputs.ready == 'true'
+        id: commit
         run: |
           if git diff --quiet -- src/data/instagram-feed.json; then
             echo "Instagram feed is unchanged."
+            echo "changed=false" >> "$GITHUB_OUTPUT"
             exit 0
           fi
 
